# KaCanOpen ROS 2 Configuration
# Environment variables for docker-compose.yml

# ROS 2 Configuration
ROS_DOMAIN_ID=0

# CAN Interface Configuration
BUSNAME=can0
BAUDRATE=1M

# Motor Control Parameters
ACCELERATION=10000
DECELERATION=20000
RESET_MOTORS_FLAG=false

# Development/Testing Options
# Uncomment the line below to use virtual CAN for testing
# BUSNAME=vcan0

# Alternative baudrates (uncomment to use)
# BAUDRATE=500K
# BAUDRATE=250K
# BAUDRATE=125K
